# Database Configuration
# Supabase PostgreSQL connection string with PgBouncer (for serverless)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=10&statement_cache_mode=none"

# Direct database connection (used for migrations)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Auth.js Configuration
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"
# For HTTPS development (recommended): https://localhost:3000
# Run with: npm run dev:https
NEXTAUTH_URL="https://localhost:3000"
# Enable secure cookies for local HTTPS development
LOCAL_HTTPS=true
INTERNAL_JWT_AUDIENCE="cpsk-job-connect"
INTERNAL_JWT_ISSUER="cpsk-job-connect-auth"
INTERNAL_JWT_TOKEN_TYPE="session"

# JWT Secret
# Generate with: openssl rand -hex 64
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-hex-64"
REFRESH_TOKEN_PEPPER="set-a-unique-64-byte-value"

# Google OAuth Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase Configuration
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Email Configuration
# Choose ONE option:

# Option 1: Console Logging (Development/Testing only)
# EMAIL_DEV_MODE=true

# Option 2: Gmail SMTP (Recommended - real emails, no domain needed)
# IMPORTANT: SMTP_PASS must be a Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Your App Name <your-email@gmail.com>

# Option 3: Resend (For production with verified domain)
# RESEND_API_KEY=your-resend-api-key

# App URL for email verification links
# For HTTPS development (recommended): https://localhost:3000
# For production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Optional seed-time admin account (development only)
# SEED_ADMIN_EMAIL=admin@cpsk.edu
# SEED_ADMIN_PASSWORD=change-me-with-long-random-value
